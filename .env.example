# Copy to .env and fill in. Only the OpenAI key is secret; the database
# credentials below match docker-compose.yml and are for local use only.
OPENAI_API_KEY=sk-...

# Where the stores are. Defaults match docker-compose.yml; set these to point elsewhere.
# GRAPHRAG_NEO4J_URI=bolt://localhost:7687
# GRAPHRAG_NEO4J_USER=neo4j
# GRAPHRAG_NEO4J_PASSWORD=graphragpassword
# GRAPHRAG_POSTGRES_URL=postgresql://graphrag:graphragpassword@localhost:5432/graphrag
